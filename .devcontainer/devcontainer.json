// PyFR HIP backend development container (ROCm 10.2, MI300X / gfx942).
// See .devcontainer/README.md.
//
// The host home directory is bind-mounted at the same absolute path, so every
// host path (the checkout, scratch dirs, other repos) is valid inside the
// container too.  The container user's $HOME stays /home/<user> in the image
// so that the in-container VS Code server and caches do not collide with the
// host's ~/.vscode-server.
//
// RENDER_GID must match the GID of the host's `render` group
// (`getent group render`); export it before opening the folder in the
// container if it differs from the default of 109.
{
  "name": "PyFR HIP (ROCm 10.2, gfx942)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "UID": "1000",
      "GID": "1000",
      "USERNAME": "dev",
      "RENDER_GID": "${localEnv:RENDER_GID:109}",
      "GPU_ARCH": "gfx942"
    }
  },
  "workspaceMount": "source=${localEnv:HOME},target=${localEnv:HOME},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "runArgs": [
    "--device=/dev/kfd", "--device=/dev/dri",
    "--group-add=video", "--group-add=render",
    "--security-opt=seccomp=unconfined",
    "--cap-add=SYS_PTRACE",
    "--ipc=host", "--init"
  ],
  "postCreateCommand": "pip install -e ${containerWorkspaceFolder} --no-deps",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-vscode.cpptools"]
    }
  }
}
